# singlet R package — native build flags
#
# Architecture: src/pz_io.cpp wraps the header-only C++ .1pz codec.
# Headers are at ../inst/include/singlet/ (subset of the full C++ library).

PKG_CPPFLAGS = -I../inst/include -std=c++17
PKG_CXXFLAGS = -std=c++17
PKG_LIBS = -lzstd -lpthread
CXX_STD = CXX17
