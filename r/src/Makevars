# singlet R package — native build flags (also used on Windows: there is no Makevars.win)
#
# src/pz_io.cpp and src/pz2_io.cpp wrap the header-only C++ .1pz / .s1 codecs in ../inst/include/singlet/.
# Zstandard is bundled (src/zstd/, compiled once through src/zstd_unity.c), so no system libzstd is needed.

PKG_CPPFLAGS = -I../inst/include -Izstd
PKG_CFLAGS = -DZSTD_DISABLE_ASM=1
CXX_STD = CXX17
