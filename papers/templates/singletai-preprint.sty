%% singletai-preprint.sty
%% Two-column preprint style for Singlet AI manuscripts.
%% Based on brenhinkeller/preprint-template.tex (CC-BY-4.0),
%% itself forked from kourgeorge/arxiv-style.
%%
%% Usage:
%%   \documentclass[10pt,twocolumn,letterpaper]{article}
%%   \usepackage{singletai-preprint}

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{singletai-preprint}[2026/03/31 Singlet AI preprint style]

\ProcessOptions\relax

% ── Fonts ────────────────────────────────────────────────────────
\IfFileExists{txfonts.sty}{%
  \AtEndOfClass{\RequirePackage{txfonts}%
    \gdef\ttdefault{cmtt}%
    \let\iint\relax  \let\iiint\relax
    \let\iiiint\relax \let\idotsint\relax
    \let\openbox\relax}%
}{\RequirePackage{times}}
\renewcommand{\rmdefault}{ptm}
\renewcommand{\sfdefault}{phv}

% ── Page geometry ────────────────────────────────────────────────
\RequirePackage[verbose=true,letterpaper]{geometry}
\AtBeginDocument{%
  \newgeometry{
    textheight=9.3in, textwidth=7.1in,
    top=0.96in, headheight=0.15in,
    headsep=0.14in, footskip=0.5in
  }%
}

