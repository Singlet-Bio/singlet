% ── Penalties ────────────────────────────────────────────────────
\widowpenalty=10000
\clubpenalty=10000
\flushbottom
\sloppy

% ── Brand color ──────────────────────────────────────────────────
\RequirePackage{xcolor}
\definecolor{singletprimary}{HTML}{0C8B84}

