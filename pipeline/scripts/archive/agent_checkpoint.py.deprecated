#!/usr/bin/env python3
"""
agent_checkpoint.py — Checkpoint management for singlify-perf 3-day autonomous run.

Provides read/write operations for the agent's persistent state. The checkpoint
stores all cycle history, metric snapshots, and resumption instructions so the
agent can continue from exactly where it left off if VS Code restarts.

Usage (from shell within VS Code agent tool calls):
    # Read current checkpoint
    python3 agent_checkpoint.py read

    # Update after a completed cycle
    python3 agent_checkpoint.py write \\
        --cycle 3 \\
        --phase "execute" \\
        --hypothesis "S2" \\
        --result "win" \\
        --metrics '{"m2_1_wall_40m_16t": 171.2}' \\
        --next "S3: K-mer pre-screening" \\
        --resume "Start S3: read src/star/findReads.cpp, design 21-mer hash table to narrow SA search"

    # Append corpus status update
    python3 agent_checkpoint.py corpus-update --id C02 --status passed

    # Generate resume prompt (paste into new VS Code agent session)
    python3 agent_checkpoint.py resume-prompt
"""

import argparse
import json
import os
import sys
from datetime import datetime

CHECKPOINT_PATH = os.path.join(os.path.dirname(__file__), "agent_checkpoint.json")
HISTORY_PATH    = os.path.join(os.path.dirname(__file__), "cycle_history.tsv")


def read_checkpoint():
    if not os.path.exists(CHECKPOINT_PATH):
        return default_checkpoint()
    with open(CHECKPOINT_PATH) as f:
        return json.load(f)


def write_checkpoint(data):
    with open(CHECKPOINT_PATH, "w") as f:
        json.dump(data, f, indent=2)
    print(f"[checkpoint] Written to {CHECKPOINT_PATH}")


def default_checkpoint():
    return {
        "sprint_start": datetime.utcnow().isoformat(),
        "sprint_end_target": "2026-04-13T23:59:00",
        "current_cycle": 0,
        "current_phase": "not_started",
        "current_hypothesis": None,
        "last_updated": None,
        "metrics": {
            "m1_protocols_passing": 0,
            "m1_protocols_tested": 0,
            "m2_1_wall_40m_16t_s": None,
            "m2_2_correctness": None,
            "m3_1_exon_pearson_r": None,
            "m4_protocols_complete": 0,
            "manuscript_last_updated": None
        },
        "corpus_status": {},
        "hypothesis_queue": ["S2", "S3", "S4", "F1"],
        "dead_ends_this_sprint": [],
        "wins_this_sprint": [],
        "cycle_history": [],
        "resume_instructions": "Start fresh: read all 5 canonical references, measure M2 baseline on SRR32855204, begin M1 format validation on C01-C07.",
        "notes": ""
    }


def cmd_read(args):
    cp = read_checkpoint()
    print(json.dumps(cp, indent=2))


def cmd_write(args):
    cp = read_checkpoint()
    now = datetime.utcnow().isoformat()

    if args.cycle is not None:
        cp["current_cycle"] = int(args.cycle)
    if args.phase:
        cp["current_phase"] = args.phase
    if args.hypothesis:
        cp["current_hypothesis"] = args.hypothesis
    if args.result:
        entry = {
            "cycle": cp["current_cycle"],
            "timestamp": now,
            "hypothesis": args.hypothesis or cp["current_hypothesis"],
            "result": args.result,
            "before": args.before or "",
            "after": args.after or "",
            "gain": args.gain or "",
            "next": args.next or "",
            "notes": args.notes or ""
        }
        cp["cycle_history"].append(entry)
        if args.result == "win":
            cp["wins_this_sprint"].append(entry)
        elif args.result == "dead_end":
            cp["dead_ends_this_sprint"].append(entry)
    if args.metrics:
        new_metrics = json.loads(args.metrics)
        cp["metrics"].update(new_metrics)
    if args.next:
        cp["resume_instructions"] = args.next
    if args.resume:
        cp["resume_instructions"] = args.resume
    if args.notes:
        cp["notes"] = args.notes

    cp["last_updated"] = now
    write_checkpoint(cp)


def cmd_corpus_update(args):
    cp = read_checkpoint()
    cp["corpus_status"][args.id] = {
        "status": args.status,
        "timestamp": datetime.utcnow().isoformat(),
        "notes": getattr(args, "notes", "")
    }
    cp["last_updated"] = datetime.utcnow().isoformat()
    write_checkpoint(cp)
    print(f"[corpus] {args.id} → {args.status}")


def cmd_resume_prompt(args):
    cp = read_checkpoint()
    
    cycle = cp.get("current_cycle", 0)
    phase = cp.get("current_phase", "unknown")
    hyp   = cp.get("current_hypothesis", "none")
    instr = cp.get("resume_instructions", "")
    metrics = cp.get("metrics", {})
    corpus  = cp.get("corpus_status", {})
    history = cp.get("cycle_history", [])
    last    = cp.get("last_updated", "unknown")

    corpus_lines = "\n".join(
        f"  {cid}: {v['status']} ({v['timestamp'][:10]})"
        for cid, v in sorted(corpus.items())
    ) or "  (no corpus runs yet)"

    history_lines = "\n".join(
        f"  Cycle {e['cycle']}: {e['hypothesis']} → {e['result']} "
        f"({e['before']} → {e['after']}, gain={e['gain']})"
        for e in history[-5:]
    ) or "  (no cycles completed yet)"

    prompt = f"""SINGLIFY-PERF AGENT RESUME — {datetime.utcnow().strftime('%Y-%m-%d %H:%M UTC')}
==========================================================================

This is a RESUME from a paused autonomous run. Read this entire block before
taking any action. Then read all 5 canonical references as always.

SPRINT: April 11-13, 2026 | Last checkpoint: {last}
CURRENT CYCLE: {cycle} | PHASE: {phase} | ACTIVE HYPOTHESIS: {hyp}

RESUME INSTRUCTION:
{instr}

CURRENT METRICS SNAPSHOT:
  M1 protocols passing: {metrics.get('m1_protocols_passing',0)}/{metrics.get('m1_protocols_tested',0)} tested
  M2.1 wall time (40M, 16T): {metrics.get('m2_1_wall_40m_16t_s') or 'not yet measured'}s
  M3.1 exon Pearson r: {metrics.get('m3_1_exon_pearson_r') or 'not yet measured'}
  M4 protocols complete: {metrics.get('m4_protocols_complete',0)}/12

CORPUS STATUS (last 10):
{corpus_lines}

LAST 5 CYCLES:
{history_lines}

ACTION: Continue immediately. Do NOT ask whether to proceed. Start the next
optimization cycle by reading the canonical references and picking up exactly
where the resume instruction says. Update the checkpoint after every Phase 1.
"""
    print(prompt)
    
    # Also write to a resume file for easy copy-paste
    resume_path = os.path.join(os.path.dirname(__file__), "RESUME.txt")
    with open(resume_path, "w") as f:
        f.write(prompt)
    print(f"\n[checkpoint] Resume prompt also written to {resume_path}")


def main():
    parser = argparse.ArgumentParser(description="singlify-perf checkpoint manager")
    sub = parser.add_subparsers(dest="command")

    sub.add_parser("read")

    wp = sub.add_parser("write")
    wp.add_argument("--cycle", type=int)
    wp.add_argument("--phase")
    wp.add_argument("--hypothesis")
    wp.add_argument("--result", choices=["win", "dead_end", "in_progress"])
    wp.add_argument("--before")
    wp.add_argument("--after")
    wp.add_argument("--gain")
    wp.add_argument("--next")
    wp.add_argument("--resume")
    wp.add_argument("--metrics")
    wp.add_argument("--notes")

    cp = sub.add_parser("corpus-update")
    cp.add_argument("--id", required=True)
    cp.add_argument("--status", required=True,
                    choices=["untested", "encode_pass", "encode_fail",
                             "decode_pass", "decode_fail",
                             "pipeline_pass", "pipeline_fail", "skipped"])
    cp.add_argument("--notes")

    sub.add_parser("resume-prompt")
    sub.add_parser("init")

    args = parser.parse_args()

    if args.command == "read":
        cmd_read(args)
    elif args.command == "write":
        cmd_write(args)
    elif args.command == "corpus-update":
        cmd_corpus_update(args)
    elif args.command == "resume-prompt":
        cmd_resume_prompt(args)
    elif args.command == "init":
        write_checkpoint(default_checkpoint())
    else:
        parser.print_help()


if __name__ == "__main__":
    main()
