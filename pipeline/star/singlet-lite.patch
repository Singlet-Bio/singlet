+
+void ParametersSolo::buildCBhashTable()
+{
+    if (cbWL.empty()) return;
+    
+    // Find next power of 2 >= 2 * cbWLsize  (load factor ≤ 0.5)
+    uint32 tableSize = 1;
+    while (tableSize < cbWLsize * 2)
+        tableSize <<= 1;
+    
+    cbHashMask = tableSize - 1;
+    cbHashTable.assign(tableSize, -1);
+    
+    for (uint64 ii = 0; ii < cbWLsize; ii++) {
+        uint64 key = cbWL[ii];
+        // Fibonacci hashing: multiply by golden ratio constant, take upper bits
+        uint32 slot = (uint32)((key * 0x9E3779B97F4A7C15ULL) >> 32) & cbHashMask;
+        while (cbHashTable[slot] != -1) {
+            slot = (slot + 1) & cbHashMask;
+        }
+        cbHashTable[slot] = (int32)ii;
+    }
+}
+
+int64 ParametersSolo::hashLookupCB(uint64 cb) const
+{
+    if (cbHashTable.empty()) return -1;
+    
+    uint32 slot = (uint32)((cb * 0x9E3779B97F4A7C15ULL) >> 32) & cbHashMask;
+    while (true) {
+        int32 idx = cbHashTable[slot];
+        if (idx == -1) return -1;          // empty slot - not found
+        if (cbWL[idx] == cb) return idx;   // found exact match
+        slot = (slot + 1) & cbHashMask;     // linear probe
+    }
+};
