include LICENSE
include README.md
include pyproject.toml

# C++ source and headers
recursive-include include *.h *.hpp
recursive-include src *.cpp

# Tests
recursive-include tests *.py

# Docs
recursive-include docs *.py *.md *.rst

# Vignettes
recursive-include vignettes *.ipynb *.py

# Exclude build artifacts and backups
prune _old_toplevel
prune build
prune dist
prune *.egg-info
global-exclude *.pyc *.pyo __pycache__
global-exclude .DS_Store
