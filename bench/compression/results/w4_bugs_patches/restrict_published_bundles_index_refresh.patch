+# ── index freshness ─────────────────────────────────────────────────────────
+# The website serves partial downloads from a cached member index (D1 bundle_index: offset, size, method per member,
+# keyed by bundle).  Rewriting the object changes every offset, the size and the ETag, so the index MUST be rebuilt in
+# the same step and checked by reading one member back through it; a study is not "done" until that holds.
+
+
+def _http_get(url: str) -> bytes:
+    req = urllib.request.Request(url, headers={"User-Agent": "singlet-migration/1"})
+    with urllib.request.urlopen(req, timeout=60) as r:
+        return r.read()
+
+
+def refresh_and_verify_index(gse: str, a, pub_size: int, probe_member: str, probe_sha256: str) -> Optional[str]:
+    """Rebuild the index for ``gse`` (``--refresh-cmd``) and read ``probe_member`` through the public API.
+
+    Returns None when the index describes the live object and the probe member hashes to ``probe_sha256``, else why not.
+    """
+    if not a.refresh_cmd:
+        return "no --refresh-cmd: the index was NOT rebuilt and is stale for this study"
+    r = subprocess.run(a.refresh_cmd.format(gse=gse), shell=True, capture_output=True, text=True, timeout=1800)
+    if r.returncode != 0:
+        return f"refresh command failed ({r.returncode}): {(r.stderr or r.stdout)[-200:]}"
+    base = a.api_base.rstrip("/")
+    idx = json.loads(_http_get(f"{base}/api/bundle/{gse}/index"))
+    if int(idx.get("bytes", -1)) != pub_size:
+        return f"index reports {idx.get('bytes')} bytes, the object has {pub_size}"
+    got = hashlib.sha256(
+        _http_get(f"{base}/api/bundle/{gse}/entry?path={urllib.request.quote(probe_member)}")
+    ).hexdigest()
+    if got != probe_sha256:
+        return f"{probe_member} read through the index hashes to {got[:12]}, expected {probe_sha256[:12]}"
+    return None
+
+
