+def _probe_candidates(path: Path):
+    """(member, sha256) of summary.json files in the new public archive, smallest first."""
+    import zipfile
+
+    with zipfile.ZipFile(path) as z:
+        man = json.loads(z.read("manifest.json"))
+        for n in man.get("checksums", {}):
+            if n.endswith("/summary.json"):
+                yield (n, man["checksums"][n])
+
