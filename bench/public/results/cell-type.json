  },
  {
   "name": "scANVI",
   "role": "competitor",
   "version": "scvi-tools 1.4.2",
   "url": "https://github.com/scverse/scvi-tools",
   "citation": "Xu et al., Mol Syst Biol 2021",
   "params": "SCVI(n_latent=30, n_layers=2, nb; batch = dataset; up to 100 epochs, early stopping) -> SCANVI.from_scvi_model (20 epochs); query: SCANVI.load_query_data + train(max_epochs=100, weight_decay=0); label = argmax of predict(soft=True)"
  },
  {
   "name": "Seurat",
   "role": "competitor",
   "version": "5.0.0",
   "url": "https://github.com/satijalab/seurat",
   "citation": "Hao et al., Cell 2021 (Azimuth)",
   "params": "reference: NormalizeData, FindVariableFeatures(2000), ScaleData, RunPCA(30); query: NormalizeData, FindTransferAnchors(reference.reduction='pca', dims=1:30), TransferData; label = predicted.id, prob = prediction.score.max"
  },
  {
   "name": "SingleR",
   "role": "competitor",
   "version": "2.0.0",
   "url": "https://bioconductor.org/packages/SingleR",
