--- /dev/null
+++ b/include/singlet/pileup/w11_timers.h
@@ -0,0 +1,45 @@
+// W11 host-time study: scoped timers. DEV BUILD ONLY. Timers only; no output changes.
+// Each timer prints one stderr line when it stops (destructor or stop()):
+//   [w11t] <section> wall_s=<..> cpu_s=<..> thr_cpu_s=<..> t0=<..> tid=<..>
+//   wall_s    steady-clock seconds
+//   cpu_s     CLOCK_PROCESS_CPUTIME_ID delta (all threads of the process: sections that run
+//             concurrently with others also count the others' CPU)
+//   thr_cpu_s CLOCK_THREAD_CPUTIME_ID delta of the thread that started AND stopped the timer
+//             (exact for a section that runs on one thread; misses helper threads it spawns)
+//   t0        seconds since the first w11 call in the process (process origin)
+#pragma once
+#include <time.h>
+#include <unistd.h>
+#include <sys/syscall.h>
+#include <chrono>
+#include <cstdio>
+#include <string>
+namespace singlet { namespace w11 {
+inline double clk(clockid_t id) { timespec ts; clock_gettime(id, &ts); return ts.tv_sec + ts.tv_nsec * 1e-9; }
+inline double wall_now() {
+    return std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+inline double origin() { static const double o = wall_now(); return o; }
+struct Scoped {
+    std::string name;
+    double w0, c0, t0;
+    bool done = false;
+    explicit Scoped(const std::string& n) : name(n) {
+        origin();
+        w0 = wall_now(); c0 = clk(CLOCK_PROCESS_CPUTIME_ID); t0 = clk(CLOCK_THREAD_CPUTIME_ID);
+    }
+    void stop() {
+        if (done) return;
+        done = true;
+        const double w1 = wall_now(), c1 = clk(CLOCK_PROCESS_CPUTIME_ID), t1 = clk(CLOCK_THREAD_CPUTIME_ID);
+        std::fprintf(stderr, "[w11t] %s wall_s=%.4f cpu_s=%.4f thr_cpu_s=%.4f t0=%.3f tid=%ld\n",
+                     name.c_str(), w1 - w0, c1 - c0, t1 - t0, w0 - origin(), static_cast<long>(syscall(SYS_gettid)));
+    }
+    ~Scoped() { stop(); }
+    Scoped(const Scoped&) = delete;
+    Scoped& operator=(const Scoped&) = delete;
+};
+// size / count notes: [w11n] key=value ...
+#define W11N(...) do { std::fprintf(stderr, "[w11n] " __VA_ARGS__); std::fprintf(stderr, "\n"); } while (0)
+}}  // namespace singlet::w11
+#define W11S(var, name) ::singlet::w11::Scoped var(name)
