+    // ---- W11 pileup dump (see pudump above) ----
+    void pileup_dump(uint32_t n_tid) {
+        if (!pudump::dir()) return;
+        using namespace pudump;
+        FILE* f = pu_open("anno.bin");
+        if (f) {
+            std::fwrite("PUANN1\0\0", 1, 8, f);
+            const auto& et = gene_model_.exon_trees_view(); const auto& it = gene_model_.intron_trees_view();
+            w<uint32_t>(f, n_tid);
+            for (uint32_t t = 0; t < n_tid; ++t) {
+                for (int k = 0; k < 2; ++k) {
+                    const IntervalTree* tr = nullptr;
+                    if (k == 0 && t < et.size()) tr = &et[t];
+                    if (k == 1 && t < it.size()) tr = &it[t];
+                    uint64_t n = tr ? tr->sorted_intervals().size() : 0;
+                    w<uint64_t>(f, n);
+                    if (n) std::fwrite(tr->sorted_intervals().data(), sizeof(Interval), n, f);
+                }
+            }
+            auto wv = [&](const auto& v) { uint64_t n = v.size(); w<uint64_t>(f, n); if (n) std::fwrite(v.data(), sizeof(v[0]), n, f); };
+            wv(gene_model_.exon_to_gene_view()); wv(gene_model_.intron_to_gene_view()); wv(gene_model_.gene_strands_view());
+            w<uint32_t>(f, static_cast<uint32_t>(chrom_snps_.size()));
+            for (const auto& v : chrom_snps_) {
+                uint64_t n = v.size(); w<uint64_t>(f, n);
+                for (const auto& s : v) { w<int32_t>(f, s.pos); w<uint32_t>(f, s.index); w<char>(f, s.ref_allele); w<char>(f, s.alt_allele); w<uint16_t>(f, 0); }
+            }
+            std::fclose(f);
+        }
+        f = pu_open("truth.bin");
+        if (f) {
+            std::fwrite("PUTRU1\0\0", 1, 8, f);
+            write_acc(f, exon_acc_); write_acc(f, intron_acc_); write_acc(f, amb_acc_);
+            write_acc(f, sj_acc_);
+            uint32_t nn = static_cast<uint32_t>(sj_names_.size()); w<uint32_t>(f, nn);
+            for (const auto& nm : sj_names_) { uint32_t l = static_cast<uint32_t>(nm.size()); w<uint32_t>(f, l); std::fwrite(nm.data(), 1, l, f); }
+            write_acc(f, snp_ad_); write_acc(f, snp_dp_);
+            write_acc(f, mt_acc_); write_acc(f, mt_acc_rev_);
+            uint64_t ni = mt_indels_.size(); w<uint64_t>(f, ni);
+            for (const auto& e : mt_indels_) { w<uint32_t>(f, e.bc_idx); w<uint32_t>(f, e.pos); w<uint32_t>(f, static_cast<uint32_t>(e.len)); w<uint32_t>(f, e.is_ins ? 1u : 0u); }
+            w<uint64_t>(f, static_cast<uint64_t>(ambig_reads_.size()));
+            std::fclose(f);
+        }
+        f = std::fopen((std::string(dir()) + "/params.txt").c_str(), "w");
+        if (f) {
+            std::fprintf(f, "stranded %d\nreverse_strand %d\nmin_mapq %d\nmin_baseq %d\ncount_introns %d\ncount_sj %d\ncount_mt %d\numi_dedup %d\n"
+                            "umi_dedup_directional %d\numi_len %d\nchrm_tid %d\nn_snps %u\nn_barcodes %zu\nn_tid %u\nhas_gene_model %d\nn_exons %u\nn_introns %u\nn_genes %u\n",
+                         (int)config_.stranded, (int)config_.reverse_strand, config_.min_mapq, config_.min_baseq, (int)config_.count_introns, (int)config_.count_sj,
+                         (int)config_.count_mt, (int)config_.umi_dedup, (int)config_.umi_dedup_directional, config_.umi_len, chrm_tid_, n_snps_loaded_,
+                         barcodes_.size(), n_tid, (int)has_gene_model_, gene_model_.n_exons(), gene_model_.n_introns(), gene_model_.n_genes());
+            std::fclose(f);
+        }
+        f = std::fopen((std::string(dir()) + "/barcodes.txt").c_str(), "w");
+        if (f) { for (const auto& b : barcodes_) std::fprintf(f, "%s\n", b.c_str()); std::fclose(f); }
+        f = std::fopen((std::string(dir()) + "/chroms.txt").c_str(), "w");
+        if (f) { for (const auto& c : tid_to_chrom_) std::fprintf(f, "%s\n", c.c_str()); std::fclose(f); }
+        std::fprintf(stderr, "[pudump] wrote anno.bin truth.bin params.txt barcodes.txt chroms.txt -> %s\n", dir());
+    }
