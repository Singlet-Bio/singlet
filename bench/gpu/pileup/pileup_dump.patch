+// ---- W11 pileup dump (GPU study): SINGLET_PILEUP_DUMP=<dir> writes the final pileup accumulators ("truth"), the annotation
+// arrays (interval trees, gene strands, SNP table), barcodes and the effective parameters after run_parallel(); a strand re-run
+// overwrites the files. Unset, it does nothing and no output of the engine changes. ----
+#include <cstdio>
+namespace singlet { namespace pudump {
+inline const char* dir() { static const char* p = std::getenv("SINGLET_PILEUP_DUMP"); return (p && *p) ? p : nullptr; }
+inline FILE* pu_open(const char* name) { std::string p = std::string(dir()) + "/" + name; FILE* f = std::fopen(p.c_str(), "wb"); return f; }
+template <typename T> inline void w(FILE* f, const T& v) { std::fwrite(&v, sizeof(T), 1, f); }
+template <typename Acc>
+inline void write_acc(FILE* f, const Acc& acc) {      // CSC triplets (row, col, value), columns ascending, rows ascending, after to_csc (sum + clamp)
+    auto csc = acc.to_csc();
+    uint32_t nr = acc.n_features(), nc = static_cast<uint32_t>(csc.indptr.size() ? csc.indptr.size() - 1 : 0);
+    uint64_t nnz = csc.indices.size();
+    w<uint32_t>(f, nr); w<uint32_t>(f, nc); w<uint64_t>(f, nnz);
+    for (uint32_t c = 0; c < nc; ++c)
+        for (int32_t k = csc.indptr[c]; k < csc.indptr[c + 1]; ++k) {
+            uint32_t row = static_cast<uint32_t>(csc.indices[k]), val = static_cast<uint32_t>(csc.data[k]);
+            w<uint32_t>(f, row); w<uint32_t>(f, c); w<uint32_t>(f, val);
+        }
+}
