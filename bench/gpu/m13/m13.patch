+++ b/include/singlet/pileup/nonhost/m13_dev.h	2026-10-28 00:02:11.922860100 -0400
@@ -0,0 +1,93 @@
+// W11 M13 dev-build helpers (NOT part of the product): timers, per-read dumps of the non-host classifier,
+// and a loader that injects GPU per-read results in place of Phases A-C of classify_multi_batch_filtered.
+//   SINGLET_NH_DUMP=<dir>          dump raw.bin (np + both hit maps in unordered_map iteration order) and multi.bin
+//                                  (the MultiHit result, rates as float bits) for every read
+//   SINGLET_NH_GPU_RESULTS=<file>  take np and the per-(read,db) species counts from the GPU program's result file
+#pragma once
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <ctime>
+#include <chrono>
+#include <string>
+#include <vector>
+#include <unordered_map>
+
+namespace singlet { namespace nonhost { namespace m13 {
+
+inline double wall() {
+    return std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+inline double cpu() {
+    timespec ts; clock_gettime(CLOCK_PROCESS_CPUTIME_ID, &ts);
+    return ts.tv_sec + ts.tv_nsec * 1e-9;
+}
+struct Lap {
+    double w0 = wall(), c0 = cpu();
+    void lap(const char* name) {
+        double w = wall(), c = cpu();
+        std::fprintf(stderr, "[m13t] %s wall_s=%.4f cpu_s=%.4f\n", name, w - w0, c - c0);
+        w0 = w; c0 = c;
+    }
+};
+
+// Dump files. One writer per call of classify_multi_batch_filtered; opened from SINGLET_NH_DUMP.
+struct Dump {
+    FILE* raw = nullptr; FILE* multi = nullptr; bool on = false;
+    Dump() {
+        const char* d = std::getenv("SINGLET_NH_DUMP");
+        if (!d || !*d) return;
+        std::string dir(d);
+        raw = std::fopen((dir + "/raw.bin").c_str(), "wb");
+        multi = std::fopen((dir + "/multi.bin").c_str(), "wb");
+        on = raw && multi;
+    }
+    ~Dump() { if (raw) std::fclose(raw); if (multi) std::fclose(multi); }
+    static void w32(FILE* f, uint32_t v) { std::fwrite(&v, 4, 1, f); }
+    // raw.bin record per read: u32 np, u32 nv, nv*(u32 sid,u32 cnt), u32 nm, nm*(u32 sid,u32 cnt); maps in iteration order
+    void raw_read(uint32_t np, const std::unordered_map<uint32_t, uint32_t>& vh,
+                  const std::unordered_map<uint32_t, uint32_t>& mh) {
+        if (!on) return;
+        w32(raw, np);
+        w32(raw, (uint32_t)vh.size());
+        for (const auto& kv : vh) { w32(raw, kv.first); w32(raw, kv.second); }
+        w32(raw, (uint32_t)mh.size());
+        for (const auto& kv : mh) { w32(raw, kv.first); w32(raw, kv.second); }
+    }
+    // multi.bin record per read: u8 top_category, u32 nvh, nvh*(u32 sid,u32 rate_bits), u32 nmh, nmh*(...)
+    template <class MH> void multi_read(const MH& m) {
+        if (!on) return;
+        uint8_t c = (uint8_t)m.top_category; std::fwrite(&c, 1, 1, multi);
+        w32(multi, (uint32_t)m.viral_hits.size());
+        for (const auto& p : m.viral_hits) { uint32_t b; std::memcpy(&b, &p.second, 4); w32(multi, p.first); w32(multi, b); }
+        w32(multi, (uint32_t)m.microbial_hits.size());
+        for (const auto& p : m.microbial_hits) { uint32_t b; std::memcpy(&b, &p.second, 4); w32(multi, p.first); w32(multi, b); }
+    }
+};
+
+// GPU result file ("NHGPURS1"): char magic[8], u64 n_reads, u64 n_groups, u32 np[n_reads], u64 g_key[n_groups], u32 g_cnt[n_groups].
+// A group is one (read, db, species) with its hit count, in the CPU's first-insertion order:
+// key = read<<33 | db<<32 | species_id, db 0 = viral map, 1 = microbial map. Groups are sorted by read, then db, then insertion order.
+struct GpuResults {
+    uint64_t n_reads = 0, n_groups = 0;
+    std::vector<uint32_t> np, g_cnt;
+    std::vector<uint64_t> g_key;
+    bool load(const char* path) {
+        FILE* f = std::fopen(path, "rb");
+        if (!f) return false;
+        char magic[8];
+        bool ok = std::fread(magic, 1, 8, f) == 8 && std::memcmp(magic, "NHGPURS1", 8) == 0 &&
+                  std::fread(&n_reads, 8, 1, f) == 1 && std::fread(&n_groups, 8, 1, f) == 1;
+        if (ok) {
+            np.resize(n_reads); g_key.resize(n_groups); g_cnt.resize(n_groups);
+            ok = std::fread(np.data(), 4, n_reads, f) == n_reads &&
+                 std::fread(g_key.data(), 8, n_groups, f) == n_groups &&
+                 std::fread(g_cnt.data(), 4, n_groups, f) == n_groups;
+        }
+        std::fclose(f);
+        return ok;
+    }
+};
+
+}}}  // namespace singlet::nonhost::m13
